{
  "name": "hourglass-server",
  "version": "1.0.0",
  "description": "Hourglass API — backend service powering event management, session-linked notes, push notification scheduling, and offline-first sync for the Hourglass mobile app.",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "postinstall": "prisma generate"
  },
  "author": "Kayode Oluwalusi",
  "license": "ISC",
  "prisma": {
    "schema": "src/db/prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "^6.2.1",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.79.2",
    "cors": "^2.8.6",
    "dotenv": "^16.4.7",
    "express": "^5.0.1",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "moment": "^2.30.1",
    "uuid": "^14.0.1",
    "winston": "^3.19.0",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.10.5",
    "prisma": "^6.2.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
